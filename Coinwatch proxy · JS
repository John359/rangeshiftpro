/**
 * coinwatch-proxy-deno.ts — CoinWatch proxy for Deno Deploy
 *
 * Deploy steps (free, no credit card):
 *   1. Push this file to a GitHub repo (any name, e.g. coinwatch-proxy).
 *   2. Go to https://dash.deno.com → New Project → Deploy from GitHub.
 *   3. Select the repo; set the entry-point to this file.
 *   4. Click Deploy. Deno gives you a URL like:
 *        https://your-project-name.deno.dev
 *   5. In coinwatch.html, change PROXY_URL to:
 *        https://your-project-name.deno.dev/binance
 *      and update the /ping fetch URL to match.
 *
 * Fix applied: removed encodeURIComponent from query string before signing.
 * Binance requires the RAW (unencoded) query string to be signed.
 */

const ALLOWED_ORIGIN = "*";

function corsHeaders(): HeadersInit {
  return {
    "Access-Control-Allow-Origin":  ALLOWED_ORIGIN,
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type",
  };
}

function json(data: unknown, status = 200): Response {
  return new Response(JSON.stringify(data), {
    status,
    headers: { ...corsHeaders(), "Content-Type": "application/json" },
  });
}

// HMAC-SHA-256 (Web Crypto — available in Deno Deploy)
async function hmacSHA256(secret: string, data: string): Promise<string> {
  const enc = new TextEncoder();
  const key = await crypto.subtle.importKey(
    "raw", enc.encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false, ["sign"]
  );
  const sig = await crypto.subtle.sign("HMAC", key, enc.encode(data));
  return Array.from(new Uint8Array(sig))
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}

Deno.serve(async (req: Request): Promise<Response> => {
  const url = new URL(req.url);

  // CORS pre-flight
  if (req.method === "OPTIONS") {
    return new Response(null, { status: 204, headers: corsHeaders() });
  }

  // Health check
  if (req.method === "GET" && url.pathname === "/ping") {
    return json({ ok: true, proxy: "CoinWatch Deno proxy", version: "1.1" });
  }

  // Signed Binance request
  if (req.method === "POST" && url.pathname === "/binance") {
    let body: {
      endpoint?: string;
      params?: Record<string, string | number>;
      apiKey?: string;
      apiSecret?: string;
    };

    try {
      body = await req.json();
    } catch {
      return json({ error: "Invalid JSON body" }, 400);
    }

    const { endpoint, params = {}, apiKey, apiSecret } = body;

    if (!endpoint || !apiKey || !apiSecret) {
      return json({ error: "Missing endpoint, apiKey or apiSecret" }, 400);
    }

    // ── KEY FIX: use raw (non-encoded) key=value pairs for signing ──
    // Binance signs the plain query string, NOT the URL-encoded version.
    // Using encodeURIComponent here causes a signature mismatch (-2015).
    const ts = Date.now();
    const allParams = { ...params, recvWindow: 10000, timestamp: ts };
    const rawQuery = Object.entries(allParams)
      .map(([k, v]) => `${k}=${v}`)   // ← raw, no encoding
      .join("&");

    const signature = await hmacSHA256(apiSecret, rawQuery);

    // Build the final Binance URL with the raw query + signature appended
    const binanceUrl =
      `https://api.binance.com${endpoint}?${rawQuery}&signature=${signature}`;

    let binanceRes: Response;
    try {
      binanceRes = await fetch(binanceUrl, {
        headers: { "X-MBX-APIKEY": apiKey },
        signal: AbortSignal.timeout(12_000),
      });
    } catch (e) {
      const msg = e instanceof Error ? e.message : String(e);
      return json({ error: `Binance request failed: ${msg}` }, 502);
    }

    const data = await binanceRes.json().catch(() => ({}));

    // Forward the exact status Binance returned so the client can tell
    // success from an API error (e.g. -2015, -1021 timestamp out of range)
    return json(data, binanceRes.status);
  }

  return json({ error: "Not found" }, 404);
});
